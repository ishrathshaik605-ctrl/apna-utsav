# ==========================================
# Apna Utsav - Environment Configuration
# ==========================================

# Port to serve application on
PORT=3000

# Host to bind (127.0.0.1 for local, 0.0.0.0 for container)
HOST=127.0.0.1

# Google Gemini API Key (Required for live AI features)
# Obtain your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Branding
APP_NAME="Apna Utsav"
